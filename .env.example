# Server-side credentials. Never use NEXT_PUBLIC_ for secrets.
TIKHUB_API_KEY=
# This application uses Alibaba Cloud Model Studio China (Beijing).
DASHSCOPE_API_KEY=
# Optional dedicated key for Qwen image, note, Douyin script and transcript correction.
# Uses DASHSCOPE_API_KEY when no Qwen key is configured.
QWEN_API_KEY=
# Dedicated Volcengine Ark key for Seedream 5.0 Flash / Pro (Beijing).
# Independent of Qwen / DashScope keys; never falls back to another provider.
ARK_API_KEY=
